# URL API completo opzionale: se impostato ha priorita su tutti i parametri sotto
PMO_PNL_MONITOR_URL=

# Coppia di citta IATA da monitorare
PMO_PNL_CITY_PAIR=PMO-PNL

# Data di partenza (YYYY-MM-DD). Se vuota viene usata la data odierna.
PMO_PNL_DEPARTURE_DATE=

# Data di ritorno opzionale (YYYY-MM-DD) per includere anche la tratta di rientro
PMO_PNL_RETURN_DATE=

# Valuta e passeggeri
PMO_PNL_CURRENCY=EUR
PMO_PNL_PASSENGER_COUNTS=ADT:1

# Filtri opzionali
PMO_PNL_CABIN_CLASS=
PMO_PNL_PROMO_CODE=
PMO_PNL_COMPANY=

# Ampiezza della finestra di ricerca in giorni
PMO_PNL_DAYS_BEFORE_DEPARTURE=1
PMO_PNL_DAYS_AFTER_DEPARTURE=8
PMO_PNL_DAYS_BEFORE_RETURN=2
PMO_PNL_DAYS_AFTER_RETURN=7

# Ogni quanti secondi fare il check
PMO_PNL_CHECK_INTERVAL_SECONDS=300

# Timeout HTTP in secondi
PMO_PNL_HTTP_TIMEOUT_SECONDS=30

# Numero minimo di posti per notificare
PMO_PNL_MIN_SEATS=1

# Etichetta leggibile della tratta
PMO_PNL_ROUTE_LABEL=Palermo <-> Pantelleria

# File locale per evitare notifiche duplicate
PMO_PNL_STATE_FILE=.pmo_pantelleria_state.json

# URL opzionale del sito di prenotazione da includere nel messaggio
PMO_PNL_BOOKING_URL=

# Notifiche Telegram opzionali
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Se true, esegue un solo controllo
RUN_ONCE=false

# Se true, non notifica al primo avvio quando la tratta e gia disponibile
SILENT_START=false
