# Endpoint da monitorare (travelOptions con cityPair PMO-PNL)
PMO_PNL_MONITOR_URL=https://api.book.dat.dk/RESTv1/travelOptions?cityPair=PMO-PNL&departure=2026-09-10&cabinClass=&currency=EUR&passengerCounts=ADT%3A1&daysBeforeDeparture=1&daysAfterDeparture=8&promoCode=&company=&return=2026-09-13&daysBeforeReturn=2&daysAfterReturn=7

# Ogni quanti secondi fare il check
PMO_PNL_CHECK_INTERVAL_SECONDS=300

# Timeout HTTP in secondi
PMO_PNL_HTTP_TIMEOUT_SECONDS=30

# Numero minimo di posti per notificare
PMO_PNL_MIN_SEATS=1

# Etichetta leggibile della tratta
PMO_PNL_ROUTE_LABEL=Palermo <-> Pantelleria

# File locale per evitare notifiche duplicate
PMO_PNL_STATE_FILE=.pmo_pantelleria_state.json

# URL opzionale del sito di prenotazione da includere nel messaggio
PMO_PNL_BOOKING_URL=

# Notifiche Telegram opzionali
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Se true, esegue un solo controllo
RUN_ONCE=false

# Se true, non notifica al primo avvio quando la tratta e gia disponibile
SILENT_START=false
